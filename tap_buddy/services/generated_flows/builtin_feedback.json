        "localization": {
          "pa": {
            "bc232819-9ecc-4735-a6be-8886abb34a7b": {
              "text": [
                "\u0a38\u0a24\u0a3f\u0a15\u0a3e\u0a30 \u0a38\u0a39\u0a3f\u0a24 \u0a28\u0a2e\u0a38\u0a15\u0a3e\u0a30! \ud83d\ude4f\ud83c\udffb\n\n\u0a26 \u0a05\u0a2a\u0a4d\u0a30\u0a48\u0a02\u0a1f\u0a3f\u0a38 \u0a2a\u0a4d\u0a30\u0a4b\u0a1c\u0a48\u0a15\u0a1f \u0a26\u0a47 \u0a35\u0a1f\u0a38\u0a10\u0a2a \u0a17\u0a30\u0a41\u0a71\u0a2a \u0a35\u0a3f\u0a71\u0a1a \u0a38\u0a3e\u0a30\u0a47 \u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a38\u0a40\u0a2a\u0a32\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a05\u0a27\u0a3f\u0a06\u0a2a\u0a15\u0a3e\u0a02 \u0a26\u0a3e \u0a26\u0a3f\u0a32\u0a4b\u0a02 \u0a38\u0a35\u0a3e\u0a17\u0a24 \u0a39\u0a48\u0964\n\nTAP Buddy \u0a07\u0a71\u0a15 AI-\u0a38\u0a70\u0a1a\u0a3e\u0a32\u0a3f\u0a24 \u0a35\u0a1f\u0a38\u0a10\u0a2a \u0a1a\u0a48\u0a1f\u0a2c\u0a3e\u0a1f \u0a39\u0a48, \u0a1c\u0a3f\u0a38\u0a28\u0a42\u0a70 \u0a09\u0a71\u0a24\u0a30 \u0a2a\u0a4d\u0a30\u0a26\u0a47\u0a38\u0a3c \u0a21\u0a3e\u0a07\u0a30\u0a48\u0a15\u0a1f\u0a4b\u0a30\u0a47\u0a1f \u0a06\u0a2b \u0a38\u0a48\u0a15\u0a70\u0a21\u0a30\u0a40 \u0a10\u0a1c\u0a42\u0a15\u0a47\u0a38\u0a3c\u0a28 \u0a05\u0a24\u0a47 \u0a26 \u0a05\u0a2a\u0a4d\u0a30\u0a48\u0a02\u0a1f\u0a3f\u0a38 \u0a2a\u0a4d\u0a30\u0a4b\u0a1c\u0a48\u0a15\u0a1f (TAP) \u0a35\u0a71\u0a32\u0a4b\u0a02 \u0a38\u0a3e\u0a02\u0a1d\u0a47 \u0a24\u0a4c\u0a30 '\u0a24\u0a47 \u0a32\u0a3e\u0a17\u0a42 \u0a15\u0a40\u0a24\u0a3e \u0a17\u0a3f\u0a06 \u0a39\u0a48\u0964 \u0a07\u0a38 \u0a2a\u0a4d\u0a30\u0a4b\u0a17\u0a30\u0a3e\u0a2e \u0a26\u0a3e \u0a09\u0a26\u0a47\u0a38\u0a3c \u0a15\u0a32\u0a3e\u0a38 9 \u0a24\u0a4b\u0a02 12 \u0a24\u0a71\u0a15 \u0a26\u0a47 \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 21\u0a35\u0a40\u0a02 \u0a38\u0a26\u0a40 \u0a26\u0a47 \u0a32\u0a3e\u0a1c\u0a3c\u0a2e\u0a40 \u0a1c\u0a40\u0a35\u0a28 \u0a15\u0a4c\u0a38\u0a3c\u0a32\u0a3e\u0a02 \u0a28\u0a3e\u0a32 \u0a38\u0a38\u0a3c\u0a15\u0a24 \u0a15\u0a30\u0a28\u0a3e \u0a39\u0a48\u0964\n\n\u0a07\u0a38 \u0a1a\u0a48\u0a1f\u0a2c\u0a3e\u0a1f \u0a30\u0a3e\u0a39\u0a40\u0a02 \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a26\u0a4b \u0a2e\u0a39\u0a71\u0a24\u0a35\u0a2a\u0a42\u0a30\u0a28 \u0a16\u0a47\u0a24\u0a30\u0a3e\u0a02 \u0a35\u0a3f\u0a71\u0a1a \u0a2e\u0a3e\u0a30\u0a17\u0a26\u0a30\u0a38\u0a3c\u0a28 \u0a2a\u0a4d\u0a30\u0a3e\u0a2a\u0a24 \u0a39\u0a4b\u0a35\u0a47\u0a17\u0a3e:\n\n\ud83d\udd39 \u0a15\u0a4b\u0a21\u0a3f\u0a70\u0a17 - \u0a17\u0a23\u0a28\u0a3e\u0a24\u0a2e\u0a15 \u0a38\u0a4b\u0a1a, \u0a38\u0a2e\u0a71\u0a38\u0a3f\u0a06 \u0a39\u0a71\u0a32 \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a2f\u0a4b\u0a17\u0a24\u0a3e \u0a05\u0a24\u0a47 \u0a21\u0a3f\u0a1c\u0a3c\u0a3f\u0a1f\u0a32 \u0a15\u0a4c\u0a38\u0a3c\u0a32 \u0a35\u0a3f\u0a15\u0a38\u0a3f\u0a24 \u0a15\u0a30\u0a28 \u0a32\u0a08\u0964\n\ud83d\udd39 \u0a35\u0a3f\u0a71\u0a24\u0a40 \u0a38\u0a3e\u0a16\u0a30\u0a24\u0a3e - \u0a27\u0a28 \u0a2a\u0a4d\u0a30\u0a2c\u0a70\u0a27\u0a28, \u0a2c\u0a1c\u0a1f \u0a2c\u0a23\u0a3e\u0a09\u0a23, \u0a2c\u0a1a\u0a24 \u0a05\u0a24\u0a47 \u0a28\u0a3f\u0a35\u0a47\u0a38\u0a3c \u0a26\u0a40 \u0a38\u0a2e\u0a1d \u0a35\u0a3f\u0a15\u0a38\u0a3f\u0a24 \u0a15\u0a30\u0a28 \u0a32\u0a08\u0964\n\n\ud83d\udcf1 \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40 WhatsApp '\u0a24\u0a47 \u0a38\u0a3f\u0a71\u0a27\u0a47 TAP Buddy Bot \u0a28\u0a3e\u0a32 \u0a38\u0a70\u0a2a\u0a30\u0a15 \u0a15\u0a30 \u0a38\u0a15\u0a23\u0a17\u0a47, \u0a1c\u0a3f\u0a38 \u0a28\u0a3e\u0a32 \u0a09\u0a39 \u0a16\u0a41\u0a26 \u0a38\u0a3f\u0a71\u0a16 \u0a38\u0a15\u0a23\u0a17\u0a47 \u0a05\u0a24\u0a47 \u0a35\u0a3f\u0a05\u0a15\u0a24\u0a40\u0a17\u0a24 \u0a21\u0a3f\u0a1c\u0a3c\u0a3f\u0a1f\u0a32 \u0a38\u0a3f\u0a71\u0a16\u0a23 \u0a26\u0a40 \u0a2f\u0a3e\u0a24\u0a30\u0a3e \u0a26\u0a3e \u0a05\u0a28\u0a41\u0a2d\u0a35 \u0a15\u0a30 \u0a38\u0a15\u0a23\u0a17\u0a47\u0964\n\n\u0a2a\u0a4d\u0a30\u0a3f\u0a70\u0a38\u0a40\u0a2a\u0a32\u0a3e\u0a02 \u0a05\u0a24\u0a47 \u0a05\u0a27\u0a3f\u0a06\u0a2a\u0a15\u0a3e\u0a02 \u0a35\u0a1c\u0a4b\u0a02 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a3e \u0a38\u0a39\u0a3f\u0a2f\u0a4b\u0a17 \u0a05\u0a24\u0a47 \u0a2e\u0a3e\u0a30\u0a17\u0a26\u0a30\u0a38\u0a3c\u0a28 \u0a38\u0a15\u0a42\u0a32 \u0a2a\u0a71\u0a27\u0a30 '\u0a24\u0a47 \u0a07\u0a38 \u0a2a\u0a4d\u0a30\u0a4b\u0a17\u0a30\u0a3e\u0a2e \u0a26\u0a40 \u0a38\u0a2b\u0a32 \u0a32\u0a3e\u0a17\u0a42 \u0a15\u0a30\u0a28 \u0a32\u0a08 \u0a2c\u0a39\u0a41\u0a24 \u0a2e\u0a39\u0a71\u0a24\u0a35\u0a2a\u0a42\u0a30\u0a28 \u0a39\u0a48\u0964 \u0a05\u0a38\u0a40\u0a02 \u0a35\u0a3f\u0a26\u0a3f\u0a06\u0a30\u0a25\u0a40\u0a06\u0a02 \u0a28\u0a42\u0a70 \u0a2d\u0a35\u0a3f\u0a71\u0a16 \u0a32\u0a08 \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a4c\u0a38\u0a3c\u0a32\u0a3e\u0a02 \u0a28\u0a3e\u0a32 \u0a38\u0a38\u0a3c\u0a15\u0a24 \u0a2c\u0a23\u0a3e\u0a09\u0a23 \u0a32\u0a08 \u0a24\u0a41\u0a39\u0a3e\u0a21\u0a47 \u0a28\u0a3e\u0a32 \u0a2e\u0a3f\u0a32 \u0a15\u0a47 \u0a15\u0a70\u0a2e \u0a15\u0a30\u0a28 \u0a26\u0a40 \u0a09\u0a2e\u0a40\u0a26 \u0a15\u0a30\u0a26\u0a47 \u0a39\u0a3e\u0a02\u0964\n\n\u0a27\u0a70\u0a28\u0a35\u0a3e\u0a26\u0964\n\u0a26 \u0a05\u0a2a\u0a4d\u0a30\u0a48\u0a02\u0a1f\u0a3f\u0a38 \u0a2a\u0a4d\u0a30\u0a4b\u0a1c\u0a48\u0a15\u0a1f (TAP)"
              ],
              "attachments": []
            }
          },
          "mr": {
            "bc232819-9ecc-4735-a6be-8886abb34a7b": {
              "text": [
                "\u0938\u0938\u094d\u0928\u0947\u0939 \u0928\u092e\u0938\u094d\u0915\u093e\u0930! \ud83d\ude4f\ud83c\udffb\n\n\u0926 \u0905\u092a\u094d\u0930\u0947\u0902\u091f\u093f\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0905\u0945\u092a \u0917\u091f\u093e\u0924 \u0938\u0930\u094d\u0935 \u092e\u0941\u0916\u094d\u092f\u093e\u0927\u094d\u092f\u093e\u092a\u0915 \u0906\u0923\u093f \u0936\u093f\u0915\u094d\u0937\u0915\u093e\u0902\u091a\u0947 \u092e\u0928\u0903\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u094d\u0935\u093e\u0917\u0924 \u0906\u0939\u0947.\n\nTAP Buddy \u0939\u093e AI-\u0906\u0927\u093e\u0930\u093f\u0924 \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0905\u0945\u092a \u091a\u0945\u091f\u092c\u0949\u091f \u0905\u0938\u0942\u0928, \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u092e\u093e\u0927\u094d\u092f\u092e\u093f\u0915 \u0936\u093f\u0915\u094d\u0937\u0923 \u0938\u0902\u091a\u093e\u0932\u0928\u093e\u0932\u092f \u0906\u0923\u093f \u0926 \u0905\u092a\u094d\u0930\u0947\u0902\u091f\u093f\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f (TAP) \u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0935\u093f\u0926\u094d\u092f\u092e\u093e\u0928\u0947 \u0930\u093e\u092c\u0935\u093f\u0923\u094d\u092f\u093e\u0924 \u092f\u0947\u0924 \u0906\u0939\u0947. \u092f\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u093e\u091a\u093e \u0909\u0926\u094d\u0926\u0947\u0936 \u0907\u092f\u0924\u094d\u0924\u093e 9 \u0924\u0947 12 \u092e\u0927\u0940\u0932 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u0928\u093e 21\u0935\u094d\u092f\u093e \u0936\u0924\u0915\u093e\u0924\u0940\u0932 \u0906\u0935\u0936\u094d\u092f\u0915 \u091c\u0940\u0935\u0928\u0915\u094c\u0936\u0932\u094d\u092f\u093e\u0902\u0928\u0940 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0923\u0947 \u0939\u093e \u0906\u0939\u0947.\n\n\u092f\u093e \u091a\u0945\u091f\u092c\u0949\u091f\u0926\u094d\u0935\u093e\u0930\u0947 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u0928\u093e \u0926\u094b\u0928 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u094d\u092f\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092e\u093f\u0933\u0947\u0932:\n\n\ud83d\udd39 \u0915\u094b\u0921\u093f\u0902\u0917 - \u0938\u0902\u0917\u0923\u0915\u0940\u092f \u0935\u093f\u091a\u093e\u0930\u0936\u0915\u094d\u0924\u0940, \u0938\u092e\u0938\u094d\u092f\u093e \u0938\u094b\u0921\u0935\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u094d\u0937\u092e\u0924\u093e \u0906\u0923\u093f \u0921\u093f\u091c\u093f\u091f\u0932 \u0915\u094c\u0936\u0932\u094d\u092f\u0947 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940.\n\ud83d\udd39 \u0906\u0930\u094d\u0925\u093f\u0915 \u0938\u093e\u0915\u094d\u0937\u0930\u0924\u093e - \u0906\u0930\u094d\u0925\u093f\u0915 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928, \u092c\u091c\u0947\u091f \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u0947, \u092c\u091a\u0924 \u0906\u0923\u093f \u0917\u0941\u0902\u0924\u0935\u0923\u0942\u0915 \u092f\u093e\u0902\u091a\u0940 \u0938\u092e\u091c \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940.\n\n\ud83d\udcf1 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u0940 WhatsApp \u0935\u0930 \u0925\u0947\u091f TAP Buddy Bot \u0938\u094b\u092c\u0924 \u0938\u0902\u0935\u093e\u0926 \u0938\u093e\u0927\u0942 \u0936\u0915\u0924\u0940\u0932, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0924\u0947 \u0938\u094d\u0935\u092f\u0902\u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0936\u093f\u0915\u0942 \u0936\u0915\u0924\u0940\u0932 \u0906\u0923\u093f \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0921\u093f\u091c\u093f\u091f\u0932 \u0936\u093f\u0915\u094d\u0937\u0923\u093e\u091a\u093e \u0905\u0928\u0941\u092d\u0935 \u0918\u0947\u090a \u0936\u0915\u0924\u0940\u0932.\n\n\u092e\u0941\u0916\u094d\u092f\u093e\u0927\u094d\u092f\u093e\u092a\u0915 \u0906\u0923\u093f \u0936\u093f\u0915\u094d\u0937\u0915 \u092e\u094d\u0939\u0923\u0942\u0928 \u0924\u0941\u092e\u091a\u0947 \u0938\u0939\u0915\u093e\u0930\u094d\u092f \u0906\u0923\u093f \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0936\u093e\u0933\u093e \u0938\u094d\u0924\u0930\u093e\u0935\u0930 \u092f\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u093e\u091a\u094d\u092f\u093e \u092f\u0936\u0938\u094d\u0935\u0940 \u0905\u0902\u092e\u0932\u092c\u091c\u093e\u0935\u0923\u0940\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947 \u0906\u0939\u0947. \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0902\u0928\u093e \u092d\u0935\u093f\u0937\u094d\u092f\u093e\u092d\u093f\u092e\u0941\u0916 \u0915\u094c\u0936\u0932\u094d\u092f\u093e\u0902\u0928\u0940 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u094b\u092c\u0924 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0909\u0924\u094d\u0938\u0941\u0915 \u0906\u0939\u094b\u0924.\n\n\u0927\u0928\u094d\u092f\u0935\u093e\u0926.\n\u0926 \u0905\u092a\u094d\u0930\u0947\u0902\u091f\u093f\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f (TAP)"
              ],
              "attachments": []
            }
          },
          "kn": {
            "bc232819-9ecc-4735-a6be-8886abb34a7b": {
              "text": [
                "\u0c86\u0ca6\u0cb0\u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0c95 \u0cb6\u0cc1\u0cad\u0cbe\u0cb6\u0caf\u0c97\u0cb3\u0cc1! \ud83d\ude4f\ud83c\udffb\n\n\u0ca6\u0cbf \u0c85\u0caa\u0ccd\u0cb0\u0cc6\u0c82\u0c9f\u0cbf\u0cb8\u0ccd \u0caa\u0ccd\u0cb0\u0cbe\u0c9c\u0cc6\u0c95\u0ccd\u0c9f\u0ccd \u0cb5\u0cbe\u0c9f\u0ccd\u0cb8\u0ccd\u0c86\u0caa\u0ccd \u0c97\u0cc1\u0c82\u0caa\u0cbf\u0c97\u0cc6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cae\u0cc1\u0c96\u0ccd\u0caf\u0ccb\u0caa\u0cbe\u0ca7\u0ccd\u0caf\u0cbe\u0caf\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0cb9\u0cc3\u0ca4\u0ccd\u0caa\u0cc2\u0cb0\u0ccd\u0cb5\u0c95 \u0cb8\u0ccd\u0cb5\u0cbe\u0c97\u0ca4.\n\nTAP Buddy \u0c92\u0c82\u0ca6\u0cc1 AI-\u0c86\u0ca7\u0cbe\u0cb0\u0cbf\u0ca4 \u0cb5\u0cbe\u0c9f\u0ccd\u0cb8\u0ccd\u0c86\u0caa\u0ccd \u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0cac\u0cbe\u0c9f\u0ccd \u0c86\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, \u0c89\u0ca4\u0ccd\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6 \u0caa\u0ccd\u0cb0\u0ccc\u0ca2 \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0ca3 \u0ca8\u0cbf\u0cb0\u0ccd\u0ca6\u0cc7\u0cb6\u0ca8\u0cbe\u0cb2\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca6\u0cbf \u0c85\u0caa\u0ccd\u0cb0\u0cc6\u0c82\u0c9f\u0cbf\u0cb8\u0ccd \u0caa\u0ccd\u0cb0\u0cbe\u0c9c\u0cc6\u0c95\u0ccd\u0c9f\u0ccd (TAP) \u0c87\u0cb5\u0cb0 \u0cb8\u0c82\u0caf\u0cc1\u0c95\u0ccd\u0ca4 \u0cb8\u0cb9\u0cad\u0cbe\u0c97\u0cbf\u0ca4\u0ccd\u0cb5\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c9c\u0cbe\u0cb0\u0cbf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c88 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb0\u0cae\u0ca6 \u0c89\u0ca6\u0ccd\u0ca6\u0cc7\u0cb6 9\u0cb0\u0cbf\u0c82\u0ca6 12\u0ca8\u0cc7 \u0ca4\u0cb0\u0c97\u0ca4\u0cbf\u0caf \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 21\u0ca8\u0cc7 \u0cb6\u0ca4\u0cae\u0cbe\u0ca8\u0ca6 \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0c9c\u0cc0\u0cb5\u0ca8 \u0c95\u0ccc\u0cb6\u0cb2\u0ccd\u0caf\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb8\u0cac\u0cb2\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.\n\n\u0c88 \u0c9a\u0cbe\u0c9f\u0ccd\u200c\u0cac\u0cbe\u0c9f\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c8e\u0cb0\u0ca1\u0cc1 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0c95\u0ccd\u0cb7\u0cc7\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0ca6\u0cca\u0cb0\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6:\n\n\ud83d\udd39 \u0c95\u0ccb\u0ca1\u0cbf\u0c82\u0c97\u0ccd - \u0c97\u0ca3\u0ca8\u0cbe\u0ca4\u0ccd\u0cae\u0c95 \u0c9a\u0cbf\u0c82\u0ca4\u0ca8\u0cc6, \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0 \u0cb8\u0cbe\u0cae\u0cb0\u0ccd\u0ca5\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0c95\u0ccc\u0cb6\u0cb2\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cad\u0cbf\u0cb5\u0cc3\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1.\n\ud83d\udd39 \u0cb9\u0ca3\u0c95\u0cbe\u0cb8\u0cc1 \u0cb8\u0cbe\u0c95\u0ccd\u0cb7\u0cb0\u0ca4\u0cc6 - \u0cb9\u0ca3\u0ca6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6, \u0cac\u0c9c\u0cc6\u0c9f\u0ccd \u0cb0\u0cc2\u0caa\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1, \u0c89\u0cb3\u0cbf\u0ca4\u0cbe\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb9\u0cc2\u0ca1\u0cbf\u0c95\u0cc6 \u0c95\u0cc1\u0cb0\u0cbf\u0ca4\u0cc1 \u0c85\u0cb0\u0cbf\u0cb5\u0cc1 \u0cac\u0cc6\u0cb3\u0cc6\u0cb8\u0cb2\u0cc1.\n\n\ud83d\udcf1 \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cb3\u0cc1 WhatsApp \u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc7\u0cb0\u0cb5\u0cbe\u0c97\u0cbf TAP Buddy Bot \u0c9c\u0cca\u0ca4\u0cc6 \u0cb8\u0c82\u0cb5\u0cb9\u0ca8 \u0ca8\u0ca1\u0cc6\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c87\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0c85\u0cb5\u0cb0\u0cc1 \u0cb8\u0ccd\u0cb5\u0ca4\u0c82\u0ca4\u0ccd\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c95\u0cb2\u0cbf\u0caf\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0c95\u0cb2\u0cbf\u0c95\u0cbe \u0c85\u0ca8\u0cc1\u0cad\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.\n\n\u0cae\u0cc1\u0c96\u0ccd\u0caf\u0ccb\u0caa\u0cbe\u0ca7\u0ccd\u0caf\u0cbe\u0caf\u0cb0\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb6\u0cbf\u0c95\u0ccd\u0cb7\u0c95\u0cb0\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cb9\u0c95\u0cbe\u0cb0 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8\u0cb5\u0cc1 \u0cb6\u0cbe\u0cb2\u0cbe \u0cae\u0c9f\u0ccd\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c88 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0cb0\u0cae\u0ca6 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf \u0c85\u0ca8\u0cc1\u0cb7\u0ccd\u0ca0\u0cbe\u0ca8\u0c95\u0ccd\u0c95\u0cc6 \u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0cae\u0cb9\u0ca4\u0ccd\u0cb5\u0ca6\u0ccd\u0ca6\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cad\u0cb5\u0cbf\u0cb7\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cbf\u0ca6\u0ccd\u0ca7\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cc1\u0cb5 \u0c95\u0ccc\u0cb6\u0cb2\u0ccd\u0caf\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb8\u0cac\u0cb2\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c95\u0cc8\u0c9c\u0ccb\u0ca1\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbe\u0cb5\u0cc1 \u0c8e\u0ca6\u0cc1\u0cb0\u0cc1 \u0ca8\u0ccb\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6.\n\n\u0ca7\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6\u0c97\u0cb3\u0cc1.\n\u0ca6\u0cbf \u0c85\u0caa\u0ccd\u0cb0\u0cc6\u0c82\u0c9f\u0cbf\u0cb8\u0ccd \u0caa\u0ccd\u0cb0\u0cbe\u0c9c\u0cc6\u0c95\u0ccd\u0c9f\u0ccd (TAP)"
              ],
              "attachments": []
            }
          },
          "hi": {
            "bc232819-9ecc-4735-a6be-8886abb34a7b": {
              "text": [
                "\u0938\u093e\u0926\u0930 \u0928\u092e\u0938\u094d\u0915\u093e\u0930! \ud83d\ude4f\ud83c\udffb\n\n\u0926 \u0905\u092a\u094d\u0930\u0947\u0902\u091f\u093f\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u0910\u092a \u0938\u092e\u0942\u0939 \u092e\u0947\u0902 \u0938\u092d\u0940 \u092a\u094d\u0930\u0927\u093e\u0928\u093e\u091a\u093e\u0930\u094d\u092f\u094b\u0902 \u0914\u0930 \u0936\u093f\u0915\u094d\u0937\u0915\u094b\u0902 \u0915\u093e \u0939\u093e\u0930\u094d\u0926\u093f\u0915 \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948\u0964\n\nTAP Buddy \u090f\u0915 AI-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u0910\u092a \u091a\u0948\u091f\u092c\u0949\u091f \u0939\u0948, \u091c\u093f\u0938\u0947 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u092e\u093e\u0927\u094d\u092f\u092e\u093f\u0915 \u0936\u093f\u0915\u094d\u0937\u093e \u0928\u093f\u0926\u0947\u0936\u093e\u0932\u092f \u0914\u0930 \u0926 \u0905\u092a\u094d\u0930\u0947\u0902\u091f\u093f\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f (TAP) \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0902\u092f\u0941\u0915\u094d\u0924 \u0930\u0942\u092a \u0938\u0947 \u0932\u093e\u0917\u0942 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0915\u094d\u0937\u093e 9 \u0938\u0947 12 \u0915\u0947 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u094b 21\u0935\u0940\u0902 \u0938\u0926\u0940 \u0915\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u091c\u0940\u0935\u0928 \u0915\u094c\u0936\u0932\u094b\u0902 \u0938\u0947 \u0938\u0936\u0915\u094d\u0924 \u092c\u0928\u093e\u0928\u093e \u0939\u0948\u0964\n\n\u0907\u0938 \u091a\u0948\u091f\u092c\u0949\u091f \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u094b \u0926\u094b \u092a\u094d\u0930\u092e\u0941\u0916 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e:\n\n\ud83d\udd39 \u0915\u094b\u0921\u093f\u0902\u0917 - \u0938\u0902\u0917\u0923\u0928\u093e\u0924\u094d\u092e\u0915 \u0938\u094b\u091a, \u0938\u092e\u0938\u094d\u092f\u093e-\u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u094d\u0937\u092e\u0924\u093e \u0914\u0930 \u0921\u093f\u091c\u093f\u091f\u0932 \u0915\u094c\u0936\u0932 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\ud83d\udd39 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u093e\u0915\u094d\u0937\u0930\u0924\u093e - \u0927\u0928 \u092a\u094d\u0930\u092c\u0902\u0927\u0928, \u092c\u091c\u091f \u092c\u0928\u093e\u0928\u093e, \u092c\u091a\u0924 \u0914\u0930 \u0928\u093f\u0935\u0947\u0936 \u0915\u0940 \u0938\u092e\u091d \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\n\ud83d\udcf1 \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u0940 WhatsApp \u092a\u0930 \u0938\u0940\u0927\u0947 TAP Buddy Bot \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0935\u093e\u0926 \u0915\u0930 \u0938\u0915\u0947\u0902\u0917\u0947, \u091c\u093f\u0938\u0938\u0947 \u0935\u0947 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0930\u0942\u092a \u0938\u0947 \u0938\u0940\u0916 \u0938\u0915\u0947\u0902\u0917\u0947 \u0914\u0930 \u090f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u093f\u091c\u093f\u091f\u0932 \u0936\u093f\u0915\u094d\u0937\u0923 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0917\u0947\u0964\n\n\u092a\u094d\u0930\u0927\u093e\u0928\u093e\u091a\u093e\u0930\u094d\u092f\u094b\u0902 \u0914\u0930 \u0936\u093f\u0915\u094d\u0937\u0915\u094b\u0902 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u0939\u092f\u094b\u0917 \u0914\u0930 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u0935\u093f\u0926\u094d\u092f\u093e\u0932\u092f \u0938\u094d\u0924\u0930 \u092a\u0930 \u0907\u0938 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0915\u0947 \u0938\u092b\u0932 \u0915\u094d\u0930\u093f\u092f\u093e\u0928\u094d\u0935\u092f\u0928 \u0915\u0947 \u0932\u093f\u090f \u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0964 \u0939\u092e \u0935\u093f\u0926\u094d\u092f\u093e\u0930\u094d\u0925\u093f\u092f\u094b\u0902 \u0915\u094b \u092d\u0935\u093f\u0937\u094d\u092f \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0915\u094c\u0936\u0932\u094b\u0902 \u0938\u0947 \u0938\u0936\u0915\u094d\u0924 \u092c\u0928\u093e\u0928\u0947 \u0939\u0947\u0924\u0941 \u0906\u092a\u0915\u0947 \u0938\u093e\u0925 \u092e\u093f\u0932\u0915\u0930 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0938\u0941\u0915 \u0939\u0948\u0902\u0964\n\n\u0927\u0928\u094d\u092f\u0935\u093e\u0926\u0964\n\u0926 \u0905\u092a\u094d\u0930\u0947\u0902\u091f\u093f\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f (TAP)"
