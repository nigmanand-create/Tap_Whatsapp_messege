# TAP Buddy - Docker Environment Template
# Copy this file to .env and fill in the values before running docker-compose up

# ---------------------------------------------------------
# FRAPPE CONFIGURATION
# ---------------------------------------------------------
FRAPPE_SITE_NAME_HEADER=tapbuddy.local
SOCKETIO_PORT=9000

# ---------------------------------------------------------
# DATABASE & CACHE CONFIGURATION
# ---------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=tapbuddy
DB_USER=postgres
DB_PASSWORD=

REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
REDIS_SOCKETIO=redis-socketio:6379

# ---------------------------------------------------------
# EXTERNAL INTEGRATIONS (GLIFIC)
# ---------------------------------------------------------
# Base URL for Glific GraphQL API (e.g., https://api.glific.test/v1)
GLIFIC_URL=

# Glific Authentication Tokens
GLIFIC_TOKEN=
GLIFIC_ACCESS_TOKEN=
GLIFIC_REFRESH_TOKEN=
GLIFIC_TOKEN_EXPIRY=

# Glific Bot Phone Number
GLIFIC_PHONE_NUMBER=

# Secret used to validate incoming webhooks from Glific
WEBHOOK_SECRET=

# ---------------------------------------------------------
# EXTERNAL INTEGRATIONS (LMS)
# ---------------------------------------------------------
# Base URL for the LMS instance
LMS_BASE_URL=

# LMS API Credentials (format: key:secret)
LMS_API_KEY=

# Set to 1 to enable automatic polling for LMS events
LMS_POLLING_ENABLED=1

# ---------------------------------------------------------
# DEVELOPMENT / DRY RUN SETTINGS
# ---------------------------------------------------------
# Target phone number used during development tests
GLIFIC_TEST_PHONE=

# Message template for basic testing
GLIFIC_TEST_MESSAGE=Test message from TAP Buddy dev

# Set to 1 to block physical message dispatch (development mode)
# Set to 0 for production/live traffic
DRY_RUN=1
